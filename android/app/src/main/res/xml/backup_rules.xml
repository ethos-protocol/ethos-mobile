<?xml version="1.0" encoding="utf-8"?>
<!--
  #200: Legacy Auto Backup rules for API < 31 (superseded by data_extraction_rules.xml
  on API 31+, but android:fullBackupContent is still required for older devices).
  Only the non-secret VaultAssociationStore preferences file is backed up.
-->
<full-backup-content>
    <include domain="sharedpref" path="vault_associations_sync.xml" />
    <exclude domain="sharedpref" path="ttl_auth_secure.xml" />
    <exclude domain="database" path="pending_actions.db" />
</full-backup-content>
